{
  "name": "@georgvahi/rg-skill",
  "version": "0.4.0",
  "private": true,
  "description": "Exact-model Luna-first repository search skill for Codex",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/rg.test.mjs",
    "test:integration": "node --test tests/rg.integration.test.mjs",
    "canary": "node scripts/canary.mjs",
    "validate": "node scripts/validate-skill.mjs",
    "doctor": "node scripts/rg.mjs doctor --repo .",
    "diff-check": "git diff --check",
    "check": "npm run validate && npm run test:unit && npm run test:integration && npm run canary && npm run diff-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgVahi/RG.git"
  },
  "license": "MIT"
}
